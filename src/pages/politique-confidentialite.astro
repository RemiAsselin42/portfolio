---
import Base from '../layouts/Base.astro';
---

<Base title="Politique de confidentialité — Rémi Asselin">
  <section class="section">
    <h1>Politique de confidentialité</h1>
    <p>
      À compléter : données collectées via le formulaire de contact (nom, email, message),
      finalité (réponse à la demande), base légale (consentement), durée de conservation,
      sous-traitant du formulaire, et droits RGPD (accès, rectification, suppression).
    </p>
    <p>Aucun cookie de suivi n'est déposé. Aucun traceur tiers.</p>
  </section>
</Base>
